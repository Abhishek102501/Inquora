# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# ---- MongoDB Atlas ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DATABASE=inqora
# Name of the Atlas Search (vector) index created on the `chunks` collection.
# See backend/README.md "Vector Search index setup" for the exact index definition.
MONGODB_VECTOR_INDEX=chunks_vector_index

# ---- Auth / JWT ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Gemini (LLM + embeddings) ----
GEMINI_API_KEY=
# Chat/generation model
GEMINI_MODEL=gemini-2.0-flash
# Embedding model. If you change this, GEMINI_EMBEDDING_DIMENSIONS MUST match
# that model's actual output dimensionality — see README before changing.
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_EMBEDDING_DIMENSIONS=768

# ---- File storage ----
# "local" is the only implementation shipped today. "s3" is reserved for a
# future StorageProvider implementation — see app/services/storage.py.
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Only used by the local storage provider.
LOCAL_STORAGE_DIR=uploads

MAX_UPLOAD_SIZE_MB=25

# ---- CORS ----
# Comma-separated list of allowed origins. No wildcard in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- RAG tuning ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=8
RETRIEVAL_MAX_CONTEXT_CHUNKS=6
RETRIEVAL_SIMILARITY_THRESHOLD=0.6
CONVERSATION_HISTORY_MESSAGES=8

# ---- Misc ----
ENVIRONMENT=development
LOG_LEVEL=INFO
