# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# ---- MongoDB Atlas ----
# Atlas database users authenticate against the `admin` database regardless
# of which database they have data access to — include authSource=admin
# explicitly, or connections will fail with a generic "bad auth" error.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority&authSource=admin
MONGODB_DATABASE=inqora
# Name of the collection chunks are stored in.
MONGODB_CHUNKS_COLLECTION=chunks
# Name of the Atlas Search (vector) index created on that collection.
# See backend/README.md "Vector Search index setup" for the exact index definition.
MONGODB_VECTOR_INDEX=chunks_vector_index

# ---- Auth / JWT ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Gemini (LLM + embeddings) ----
GEMINI_API_KEY=
# Chat/generation model. Model availability varies by API key/account —
# call GET https://generativelanguage.googleapis.com/v1beta/models?key=... to
# see what your key can actually use before assuming a model name works.
GEMINI_MODEL=gemini-3.6-flash
# Embedding model. gemini-embedding-001 supports a configurable
# outputDimensionality (768 / 1536 / 3072). Whatever you choose here MUST
# match GEMINI_EMBEDDING_DIMENSIONS below AND the numDimensions of the
# Atlas Vector Search index — see README before changing either.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1536

# ---- File storage ----
# "local" is the only implementation shipped today. "s3" is reserved for a
# future StorageProvider implementation — see app/services/storage.py.
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Only used by the local storage provider.
LOCAL_STORAGE_DIR=uploads

MAX_UPLOAD_SIZE_MB=25

# ---- CORS ----
# Comma-separated list of allowed origins. No wildcard in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- RAG tuning ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=8
RETRIEVAL_MAX_CONTEXT_CHUNKS=6
RETRIEVAL_SIMILARITY_THRESHOLD=0.6
CONVERSATION_HISTORY_MESSAGES=8

# ---- Misc ----
ENVIRONMENT=development
LOG_LEVEL=INFO
